{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k \"tsc -w --preserveWatchOutput\" \"nodemon --watch dist --delay 1 dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "agent": "node dist/agent/agent.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/websockets": "^10.4.4",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-git": "^3.27.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4",
    "typescript": "^5.5.4"
  }
